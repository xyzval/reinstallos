# Telegram Bot Token (dapatkan dari @BotFather di Telegram)
BOT_TOKEN=your_bot_token_here

# Telegram User ID owner utama (wajib, hanya angka)
# Owner dapat menambah user lain melalui menu "Kelola User" di bot.
OWNER_ID=123456789

# Kompatibilitas instalasi lama saja; jangan digunakan untuk instalasi baru.
# ALLOWED_USERS=123456789,987654321
